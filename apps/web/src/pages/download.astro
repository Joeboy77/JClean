---
import { PlatformCards } from "../components/PlatformCards";
import Base from "../layouts/Base.astro";
import { RELEASES_URL, downloads, formatDate, latestRelease } from "../lib/release";

const release = await latestRelease();
const { mac, windows, linux } = downloads(release);
const others = [windows && "Windows", linux && "Linux"].filter(Boolean);
---

<Base
  title="Download"
  description={`Download JClean for ${others.length ? `Mac, ${others.join(" and ")}` : "Mac"}: free and open source. How to open it the first time, checksums and system requirements.`}
>
  <section class="mx-auto max-w-4xl px-4 pt-14 sm:px-6">
    <h1 class="text-2xl font-semibold text-text">Download JClean</h1>
    <p class="mt-2 text-muted">
      {release.version ? `Version ${release.version}` : "Latest version"}
      {release.publishedAt && ` · released ${formatDate(release.publishedAt)}`}
      · {others.length ? `for Mac (Apple Silicon and Intel), ${others.join(" and ")}.` : "one download for Apple Silicon and Intel Macs."}
    </p>
    <div class="mt-8">
      <PlatformCards client:load mac={mac} windows={windows} linux={linux} releasesUrl={RELEASES_URL} />
    </div>
  </section>

  <section id="install-mac" class="mx-auto mt-14 max-w-4xl scroll-mt-20 px-4 sm:px-6" aria-labelledby="first">
    <div class="rounded-card border-2 border-review/50 bg-review/10 p-6 sm:p-8">
      <h2 id="first" class="flex items-center gap-2 text-xl font-semibold text-text">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-review">
          <path d="M12 3 2 21h20L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round"></path>
          <path d="M12 10v5m0 3h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round"></path>
        </svg>
        Opening JClean the first time{others.length > 0 && " on a Mac"}
      </h2>
      <p class="mt-3 text-text">
        JClean isn't notarized by Apple yet, so macOS blocks it the first time. This is expected, and you only have to do it once. It takes about 30 seconds.
      </p>

      <ol class="mt-8 space-y-8">
        <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
          <div>
            <p class="text-sm font-medium text-accent-text">Step 1</p>
            <p class="mt-1 text-md text-text">Open the downloaded DMG and drag <strong>JClean</strong> into <strong>Applications</strong>.</p>
          </div>
          <div class="flex items-center justify-center gap-6 rounded-control border border-line bg-bg p-5" aria-hidden="true">
            <div class="text-center">
              <div class="mx-auto grid size-14 place-items-center rounded-[14px] bg-accent-strong text-white">
                <svg width="28" height="28" viewBox="0 0 24 24" fill="none"><rect x="2" y="2" width="10.5" height="20" rx="2" fill="currentColor"></rect><rect x="14.5" y="2" width="7.5" height="10" rx="2" fill="currentColor" opacity="0.6"></rect></svg>
              </div>
              <p class="mt-1 text-xs text-muted">JClean</p>
            </div>
            <span class="text-lg text-muted">→</span>
            <div class="text-center">
              <div class="mx-auto grid size-14 place-items-center rounded-[14px] bg-cat-apps/40 text-text">A</div>
              <p class="mt-1 text-xs text-muted">Applications</p>
            </div>
          </div>
        </li>

        <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
          <div>
            <p class="text-sm font-medium text-accent-text">Step 2</p>
            <p class="mt-1 text-md text-text">Open JClean. macOS says it can't verify the app. Click <strong>Done</strong>.</p>
            <p class="mt-2 text-sm text-caution-text">Don't click "Move to Trash".</p>
          </div>
          <div class="rounded-control border border-line bg-bg p-5 text-center" aria-hidden="true">
            <p class="text-sm font-semibold text-text">"JClean" Not Opened</p>
            <p class="mx-auto mt-1 max-w-xs text-xs text-muted">Apple could not verify "JClean" is free of malware that may harm your Mac or compromise your privacy.</p>
            <div class="mt-3 flex justify-center gap-2">
              <span class="rounded-row bg-accent-strong px-4 py-1 text-xs text-white ring-2 ring-accent/50">Done</span>
              <span class="rounded-row bg-raised px-3 py-1 text-xs text-muted line-through">Move to Trash</span>
            </div>
          </div>
        </li>

        <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
          <div>
            <p class="text-sm font-medium text-accent-text">Step 3</p>
            <p class="mt-1 text-md text-text">
              Open <strong>System Settings → Privacy &amp; Security</strong>, scroll down to <em>"JClean" was blocked to protect your Mac</em>, and click <strong>Open Anyway</strong>. Enter your password when asked.
            </p>
          </div>
          <div class="rounded-control border border-line bg-bg p-5" aria-hidden="true">
            <p class="text-xs font-medium text-muted">Privacy &amp; Security › Security</p>
            <div class="mt-3 flex items-center justify-between gap-3 rounded-row border border-line bg-surface p-3">
              <p class="text-xs text-text">"JClean" was blocked to protect your Mac.</p>
              <span class="shrink-0 rounded-row bg-accent-strong px-3 py-1 text-xs text-white ring-2 ring-accent/50">Open Anyway</span>
            </div>
          </div>
        </li>

        <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
          <div>
            <p class="text-sm font-medium text-accent-text">Step 4</p>
            <p class="mt-1 text-md text-text">JClean opens. From now on it opens like any other app.</p>
          </div>
          <p class="text-sm text-muted">
            Updates install from inside JClean (Settings → Updates) and don't need these steps again.
          </p>
        </li>
      </ol>
    </div>
    <p class="mt-4 text-sm text-muted">
      Why the warning? Apple charges developers to notarize apps, and JClean is a free project. The code is open on GitHub, and you can check the file you downloaded against the checksum below.
    </p>
  </section>

  {
    windows && (
      <section id="install-windows" class="mx-auto mt-14 max-w-4xl scroll-mt-20 px-4 sm:px-6" aria-labelledby="windows-first">
        <div class="rounded-card border-2 border-review/50 bg-review/10 p-6 sm:p-8">
          <h2 id="windows-first" class="flex items-center gap-2 text-xl font-semibold text-text">
            <svg width="22" height="22" viewBox="0 0 24 24" fill="none" aria-hidden="true" class="text-review">
              <path d="M12 3 2 21h20L12 3Z" stroke="currentColor" stroke-width="2" stroke-linejoin="round" />
              <path d="M12 10v5m0 3h.01" stroke="currentColor" stroke-width="2" stroke-linecap="round" />
            </svg>
            Installing on Windows
          </h2>
          <p class="mt-3 text-text">
            The installer isn't code-signed yet, so Windows SmartScreen may stop it the first time. This is expected, and you only see it when installing.
          </p>
          <ol class="mt-8 space-y-8">
            <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
              <div>
                <p class="text-sm font-medium text-accent-text">Step 1</p>
                <p class="mt-1 text-md text-text">
                  Open <strong>JClean_windows_x64_setup.exe</strong>. If Windows says it <em>protected your PC</em>, click <strong>More info</strong>.
                </p>
                <p class="mt-2 text-sm text-caution-text">Don't click "Don't run".</p>
              </div>
              <div class="rounded-control border border-line bg-[#0b3d91] p-5 text-white" aria-hidden="true">
                <p class="text-md font-semibold">Windows protected your PC</p>
                <p class="mt-2 text-xs text-white/85">
                  Microsoft Defender SmartScreen prevented an unrecognized app from starting.
                </p>
                <span class="mt-2 inline-block rounded-row px-1 text-xs underline ring-2 ring-white/70">More info</span>
                <div class="mt-4 flex justify-end">
                  <span class="rounded-row border border-white/60 px-4 py-1 text-xs text-white/70 line-through">Don't run</span>
                </div>
              </div>
            </li>
            <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
              <div>
                <p class="text-sm font-medium text-accent-text">Step 2</p>
                <p class="mt-1 text-md text-text">
                  Check the publisher line says <strong>Unknown publisher</strong> and the app is <strong>JClean</strong>, then click <strong>Run anyway</strong>.
                </p>
              </div>
              <div class="rounded-control border border-line bg-[#0b3d91] p-5 text-white" aria-hidden="true">
                <p class="text-md font-semibold">Windows protected your PC</p>
                <p class="mt-2 text-xs text-white/85">App: JClean_windows_x64_setup.exe</p>
                <p class="text-xs text-white/85">Publisher: Unknown publisher</p>
                <div class="mt-4 flex justify-end gap-2">
                  <span class="rounded-row border border-white/60 px-3 py-1 text-xs ring-2 ring-white/70">Run anyway</span>
                  <span class="rounded-row border border-white/60 px-3 py-1 text-xs text-white/70">Don't run</span>
                </div>
              </div>
            </li>
            <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
              <div>
                <p class="text-sm font-medium text-accent-text">Step 3</p>
                <p class="mt-1 text-md text-text">
                  The installer puts JClean in your account only, so it doesn't ask for an administrator password. JClean opens when it's done.
                </p>
              </div>
              <p class="text-sm text-muted">
                Updates install from inside JClean (Settings → Updates) and don't show this warning again.
              </p>
            </li>
          </ol>
          <div class="mt-8 rounded-control border border-line bg-bg p-4">
            <p class="font-medium text-text">"Smart App Control blocked an app that may be unsafe"?</p>
            <p class="mt-1 text-sm text-muted">
              Some new Windows 11 PCs have Smart App Control on, which blocks every app that isn't code-signed and has no Run anyway button. JClean's installer will be signed in a future version. Until then it can only be installed with Smart App Control off (Windows Security → App &amp; browser control → Smart App Control). On most versions of Windows 11 it can't be turned back on without reinstalling Windows, so only do this if you're comfortable with that.
            </p>
          </div>
        </div>
      </section>
    )
  }

  {
    linux && (
      <section id="install-linux" class="mx-auto mt-14 max-w-4xl scroll-mt-20 px-4 sm:px-6" aria-labelledby="linux-first">
        <div class="rounded-card border border-line bg-surface p-6 sm:p-8">
          <h2 id="linux-first" class="text-xl font-semibold text-text">Installing on Linux</h2>
          <p class="mt-3 text-text">
            Pick one: the <strong>.deb</strong> for Ubuntu, Debian, Mint and Pop!_OS, or the <strong>AppImage</strong> for any other distribution. Both update themselves from Settings → Updates.
          </p>

          <h3 class="mt-8 text-md font-semibold text-text">.deb (Ubuntu, Debian, Mint, Pop!_OS)</h3>
          <ol class="mt-4 space-y-6">
            <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
              <div class="min-w-0">
                <p class="text-sm font-medium text-accent-text">Step 1</p>
                <p class="mt-1 text-md text-text">
                  Open your <strong>Downloads</strong> folder in Files, right-click an empty spot and choose <strong>Open in Terminal</strong>.
                </p>
              </div>
              <div class="min-w-0">
                <p class="text-sm text-muted">Double-clicking the .deb may open App Center, which can't always install downloaded packages. The terminal always works.</p>
              </div>
            </li>
            <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
              <div class="min-w-0">
                <p class="text-sm font-medium text-accent-text">Step 2</p>
                <p class="mt-1 text-md text-text">Install it with apt and enter your password. apt also installs anything JClean needs.</p>
              </div>
              <div class="min-w-0"><pre class="mt-3 overflow-x-auto rounded-control border border-line bg-bg p-3 font-mono text-xs text-text">sudo apt install ./JClean_linux_amd64.deb</pre></div>
            </li>
            <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
              <div class="min-w-0">
                <p class="text-sm font-medium text-accent-text">Step 3</p>
                <p class="mt-1 text-md text-text">Open <strong>JClean</strong> from your apps. That's it.</p>
              </div>
            </li>
          </ol>

          <h3 class="mt-10 text-md font-semibold text-text">AppImage (any distribution)</h3>
          <ol class="mt-4 space-y-6">
            <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
              <div class="min-w-0">
                <p class="text-sm font-medium text-accent-text">Step 1</p>
                <p class="mt-1 text-md text-text">
                  Install FUSE 2, which AppImages need and newer systems leave out. Without it, nothing happens when you open the file.
                </p>
              </div>
              <div class="min-w-0">
                <pre class="mt-3 overflow-x-auto rounded-control border border-line bg-bg p-3 font-mono text-xs text-text"># Ubuntu 24.04 and newer
sudo apt install libfuse2t64

# Ubuntu 22.04, Debian, Mint
sudo apt install libfuse2

# Fedora
sudo dnf install fuse-libs</pre>
              </div>
            </li>
            <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
              <div class="min-w-0">
                <p class="text-sm font-medium text-accent-text">Step 2</p>
                <p class="mt-1 text-md text-text">
                  Allow it to run: right-click <strong>JClean_linux_x86_64.AppImage</strong>, choose <strong>Properties</strong>, and turn on <strong>Executable as Program</strong>.
                </p>
                <p class="mt-2 text-sm text-muted">Or in a terminal: <code class="font-mono text-text">chmod +x JClean_linux_x86_64.AppImage</code></p>
              </div>
              <div class="min-w-0 rounded-control border border-line bg-bg p-5" aria-hidden="true">
                <p class="text-xs font-medium text-muted">JClean_linux_x86_64.AppImage · Properties</p>
                <div class="mt-3 flex items-center justify-between gap-3 rounded-row border border-line bg-surface p-3">
                  <p class="text-xs text-text">Executable as Program</p>
                  <span class="relative inline-block h-5 w-9 rounded-full bg-accent-strong ring-2 ring-accent/50">
                    <span class="absolute top-0.5 right-0.5 size-4 rounded-full bg-white"></span>
                  </span>
                </div>
              </div>
            </li>
            <li class="grid gap-4 sm:grid-cols-[1fr_1fr] sm:items-center">
              <div class="min-w-0">
                <p class="text-sm font-medium text-accent-text">Step 3</p>
                <p class="mt-1 text-md text-text">Double-click it to open JClean. Keep the file somewhere permanent, like a folder called Applications in your home.</p>
              </div>
            </li>
          </ol>

          <p class="mt-8 text-sm text-muted">
            <strong class="text-text">Tray icon on GNOME:</strong> it needs the AppIndicator extension. Ubuntu includes it; on Fedora, install <em>AppIndicator and KStatusNotifierItem Support</em> from Extension Manager.
          </p>
        </div>
      </section>
    )
  }

  <section class="mx-auto mt-14 grid max-w-4xl gap-6 px-4 sm:grid-cols-2 sm:px-6">
    <div class="rounded-card border border-line bg-surface p-6" aria-labelledby="req">
      <h2 id="req" class="text-lg font-semibold text-text">System requirements</h2>
      <p class="mt-3 text-sm font-medium text-text">Mac</p>
      <ul class="mt-1 space-y-1.5 text-muted">
        <li>macOS 12 Monterey or later</li>
        <li>Apple Silicon or Intel</li>
        <li>About 25 MB of free space</li>
        <li>Full Disk Access is optional, and shows Safari, Mail, iPhone backups and the Trash</li>
      </ul>
      {
        windows && (
          <>
            <p class="mt-4 text-sm font-medium text-text">Windows</p>
            <ul class="mt-1 space-y-1.5 text-muted">
              <li>Windows 10 or 11, 64-bit</li>
              <li>About 25 MB of free space</li>
              <li>Cleaning Windows Update files and old Windows versions asks for administrator approval</li>
            </ul>
          </>
        )
      }
      {
        linux && (
          <>
            <p class="mt-4 text-sm font-medium text-text">Linux</p>
            <ul class="mt-1 space-y-1.5 text-muted">
              <li>64-bit, with a recent desktop (GNOME, KDE Plasma or similar)</li>
              <li>The .deb is for Ubuntu 22.04, Debian 12 and newer</li>
              <li>Clearing system package caches and old logs asks for your password</li>
            </ul>
          </>
        )
      }
    </div>
    <div class="rounded-card border border-line bg-surface p-6" aria-labelledby="other">
      <h2 id="other" class="text-lg font-semibold text-text">Other platforms</h2>
      <ul class="mt-3 space-y-1.5 text-muted">
        <li>
          <strong class="text-text">Windows:</strong>{" "}
          {windows ? <a href={windows.url} class="text-accent hover:underline">download</a> : "coming soon"}
        </li>
        <li>
          <strong class="text-text">Linux:</strong>{" "}
          {linux ? <a href={linux.url} class="text-accent hover:underline">download</a> : "coming soon"}
        </li>
      </ul>
      <a href={RELEASES_URL} class="mt-3 inline-block text-sm text-accent hover:underline">All versions on GitHub</a>
    </div>
  </section>

  {
    release.checksums.length > 0 && (
      <section class="mx-auto mt-6 max-w-4xl px-4 sm:px-6" aria-labelledby="sums">
        <div class="rounded-card border border-line bg-surface p-6">
          <h2 id="sums" class="text-lg font-semibold text-text">Checksums (SHA-256)</h2>
          <p class="mt-1 text-sm text-muted">
            To check your download, run <code class="font-mono text-text">shasum -a 256 {release.checksums[0]?.file}</code> in Terminal and compare.
            {windows && (
              <>
                {" "}On Windows, run <code class="font-mono text-text">Get-FileHash JClean_windows_x64_setup.exe</code> in PowerShell.
              </>
            )}
            {linux && (
              <>
                {" "}On Linux, run <code class="font-mono text-text">sha256sum</code> on the file.
              </>
            )}
          </p>
          <ul class="mt-3 space-y-2">
            {release.checksums.map((c) => (
              <li class="overflow-x-auto">
                <p class="text-xs text-muted">{c.file}</p>
                <code class="block font-mono text-xs break-all text-text">{c.sha256}</code>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )
  }
</Base>
