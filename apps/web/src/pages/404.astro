---
import Base from "../layouts/Base.astro";
---

<Base title="Page not found">
  <section class="mx-auto max-w-xl px-4 pt-24 text-center sm:px-6">
    <h1 class="text-2xl font-semibold text-text">That page isn't here</h1>
    <p class="mt-3 text-muted">It may have moved. Try the home page or the download page.</p>
    <div class="mt-6 flex justify-center gap-3">
      <a href="/" class="rounded-control border border-line bg-raised px-4 py-2 text-text">Home</a>
      <a href="/download" class="rounded-control bg-accent-strong px-4 py-2 font-medium text-white">Download</a>
    </div>
  </section>
</Base>
