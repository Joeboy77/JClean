[
  {
    "id": "windows.jetbrains.old-caches",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Editors and IDEs",
    "labels": {
      "developer": "JetBrains caches and logs from old versions",
      "everyday": "Leftovers from old JetBrains IDE versions"
    },
    "description": {
      "what": "Caches and logs from IDE versions you've upgraded from. The newest version of each IDE is kept.",
      "ifCleared": "Nothing: those versions aren't used anymore."
    },
    "icon": "code",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": ["{localAppData}/JetBrains/*"]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete"
    },
    "keep": {
      "newest": 1,
      "groupBy": "name"
    }
  },
  {
    "id": "windows.jetbrains.old-settings",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Editors and IDEs",
    "labels": {
      "developer": "JetBrains settings from old versions",
      "everyday": "Settings from old JetBrains IDE versions"
    },
    "description": {
      "what": "Settings and plugins from IDE versions you've upgraded from. The newest version of each IDE is kept.",
      "ifCleared": "They move to the Recycle Bin. Old versions of the IDE lose their settings."
    },
    "icon": "code",
    "risk": "review",
    "regenerates": false,
    "detect": {
      "kind": "fixed",
      "paths": ["{appData}/JetBrains/*"]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "trash"
    },
    "keep": {
      "newest": 1,
      "groupBy": "name"
    }
  },
  {
    "id": "windows.editors.vscode-caches",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Editors and IDEs",
    "labels": {
      "developer": "VS Code caches and logs",
      "everyday": "Temporary files from VS Code"
    },
    "description": {
      "what": "Caches, downloaded extension packages and logs VS Code keeps.",
      "ifCleared": "VS Code rebuilds them. Your settings, extensions and projects aren't touched."
    },
    "icon": "code",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": [
        "{appData}/Code/Cache",
        "{appData}/Code/CachedData",
        "{appData}/Code/CachedExtensionVSIXs",
        "{appData}/Code/Code Cache",
        "{appData}/Code/GPUCache"
      ]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete",
      "keepRoot": true
    },
    "relatedApps": ["code.exe"]
  },
