    "category": "developer",
    "group": "Editors and IDEs",
    "labels": {
      "developer": "Old editor extension versions",
      "everyday": "Old versions of editor extensions"
    },
    "description": {
      "what": "Older copies of extensions left behind after updates. The newest version of each is kept.",
      "ifCleared": "Nothing: the editor uses the newest version."
