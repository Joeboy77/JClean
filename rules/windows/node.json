      "folders": ["node_modules"]
    },
    "unused": {
      "basis": "project-activity",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete"
    }
  },
  {
    "id": "windows.node.project-caches",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Project build folders",
    "labels": {
      "developer": "Framework build caches (.next, .nuxt, .turbo…)",
      "everyday": "Build caches in old projects"
    },
    "description": {
      "what": "Caches that JavaScript frameworks and bundlers write inside a project.",
      "ifCleared": "The next build or dev server run recreates them, a little slower the first time."
    },
    "icon": "folder-cog",
    "risk": "safe",
