        ".turbo",
        ".parcel-cache",
        ".svelte-kit",
        ".angular/cache",
        ".expo"
      ]
    },
    "unused": {
      "basis": "project-activity",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete"
    }
  },
  {
    "id": "windows.node.project-output",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Project build folders",
    "labels": {
