  {
    "id": "windows.node.old-node-versions",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "SDKs and runtimes",
    "labels": {
      "developer": "Old Node.js versions (nvm, Volta, fnm)",
      "everyday": "Old versions of Node.js"
    },
    "description": {
      "what": "Node.js versions installed by a version manager. The newest one is kept.",
      "ifCleared": "Projects that need an old version will ask you to install it again."
    },
    "icon": "hexagon",
    "risk": "review",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": [
        "{appData}/nvm/v*",
        "{localAppData}/Volta/tools/image/node/*",
        "{appData}/fnm/node-versions/*"
      ]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete"
    },
    "keep": {
      "newest": 1,
      "groupBy": "parent"
    }
  },
  {
    "id": "windows.node.project-dependencies",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Project build folders",
    "labels": {
