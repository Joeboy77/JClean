[
  {
    "id": "windows.node.npm-cache",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Package caches",
    "labels": {
      "developer": "npm cache",
      "everyday": "Downloaded packages (npm)"
    },
    "description": {
      "what": "Copies of every package npm has downloaded, kept so installs are faster.",
      "ifCleared": "npm downloads packages again the next time you install them. Nothing in your projects changes."
    },
    "icon": "package",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": ["{localAppData}/npm-cache/_cacache"]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "command",
      "command": {
        "tool": "npm",
        "args": ["cache", "clean", "--force"]
      },
      "fallback": "delete"
    },
    "docs": "https://docs.npmjs.com/cli/commands/npm-cache"
  },
  {
    "id": "windows.node.yarn-cache",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Package caches",
    "labels": {
      "developer": "Yarn cache",
      "everyday": "Downloaded packages (Yarn)"
    },
    "description": {
      "what": "Copies of packages Yarn has downloaded, kept so installs are faster.",
      "ifCleared": "Yarn downloads them again the next time you install or build. Nothing in your projects changes."
    },
    "icon": "package",
    "risk": "safe",
    "regenerates": true,
