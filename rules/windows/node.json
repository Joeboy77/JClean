      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete"
    }
  },
  {
    "id": "windows.node.pnpm-store",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Package caches",
    "labels": {
      "developer": "pnpm store",
      "everyday": "Downloaded packages (pnpm)"
    },
    "description": {
      "what": "pnpm's shared store of packages. Projects link to it, so only unused packages can be removed.",
      "ifCleared": "pnpm removes packages no project uses. Projects keep working."
    },
    "icon": "package",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": ["{localAppData}/pnpm/store"]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "command",
      "command": {
        "tool": "pnpm",
        "args": ["store", "prune"]
      }
    },
    "mayShareBlocks": true
  },
