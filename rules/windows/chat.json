[
  {
    "id": "windows.chat.slack",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["everyday", "developer"],
    "category": "apps",
    "group": "Chat and media apps",
    "labels": {
      "developer": "Slack cache",
      "everyday": "Slack's saved data"
    },
    "description": {
      "what": "Images, files and page data Slack keeps so conversations load faster.",
      "ifCleared": "The app downloads what it needs again. Your messages, files and settings aren't touched."
    },
    "icon": "message-square",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": [
        "{appData}/Slack/Cache",
        "{appData}/Slack/Code Cache",
        "{appData}/Slack/GPUCache",
        "{appData}/Slack/Service Worker/CacheStorage"
      ]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete",
      "keepRoot": true
    },
    "relatedApps": ["slack.exe"]
  },
