[
  {
    "id": "windows.browsers.chrome",
    "version": 1,
    "platforms": ["windows"],
    "audience": ["everyday", "developer"],
    "category": "apps",
    "group": "Browser caches",
    "labels": {
      "developer": "Chrome cache",
      "everyday": "Chrome's saved web data"
    },
    "description": {
      "what": "Copies of web pages, scripts and images Chrome keeps to load sites faster.",
      "ifCleared": "The browser downloads pages and images again as you visit sites. You stay signed in, and your history, bookmarks and passwords aren't touched."
    },
    "icon": "globe",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": [
        "{localAppData}/Google/Chrome/User Data/*/Cache",
        "{localAppData}/Google/Chrome/User Data/*/Code Cache",
        "{localAppData}/Google/Chrome/User Data/*/GPUCache",
        "{localAppData}/Google/Chrome/User Data/*/Service Worker/CacheStorage"
      ]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete",
      "keepRoot": true
    },
    "relatedApps": ["chrome.exe"]
  },
