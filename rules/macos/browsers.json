[
  {
    "id": "macos.browsers.safari",
    "version": 1,
    "platforms": ["macos"],
    "audience": ["everyday", "developer"],
    "category": "apps",
    "group": "Browser caches",
    "labels": {
      "developer": "Safari cache",
      "everyday": "Safari's saved web data"
    },
    "description": {
      "what": "Copies of web pages and images Safari keeps to load sites faster. Needs Full Disk Access to measure.",
      "ifCleared": "The browser downloads pages and images again as you visit sites. You stay signed in, and your history, bookmarks and passwords aren't touched."
    },
    "icon": "compass",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": [
        "{caches}/com.apple.Safari",
        "{home}/Library/Containers/com.apple.Safari/Data/Library/Caches"
      ]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete",
      "keepRoot": true
    },
    "relatedApps": ["Safari"]
  },
  {
    "id": "macos.browsers.chrome",
