[
  {
    "id": "macos.chat.slack",
    "version": 1,
    "platforms": ["macos"],
    "audience": ["everyday", "developer"],
    "category": "apps",
    "group": "Chat and media apps",
    "labels": {
      "developer": "Slack cache",
      "everyday": "Slack's saved data"
    },
    "description": {
      "what": "Images, files and page data Slack keeps so conversations load faster.",
      "ifCleared": "The app downloads what it needs again. Your messages, files and settings aren't touched."
    },
    "icon": "message-square",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": [
        "{appSupport}/Slack/Cache",
        "{appSupport}/Slack/Code Cache",
        "{appSupport}/Slack/GPUCache",
        "{appSupport}/Slack/Service Worker/CacheStorage",
        "{home}/Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack/Cache",
        "{home}/Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack/Code Cache",
        "{home}/Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack/GPUCache",
        "{home}/Library/Containers/com.tinyspeck.slackmacgap/Data/Library/Application Support/Slack/Service Worker/CacheStorage"
      ]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete",
      "keepRoot": true
    },
    "relatedApps": ["Slack"]
  },
