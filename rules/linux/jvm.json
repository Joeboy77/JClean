  {
    "id": "linux.gradle.caches",
    "version": 1,
    "platforms": ["linux"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Package caches",
    "labels": {
      "developer": "Gradle caches",
      "everyday": "Downloaded packages (Gradle)"
    },
    "description": {
      "what": "Dependencies and build outputs Gradle keeps between builds.",
      "ifCleared": "Gradle downloads them again the next time you install or build. Nothing in your projects changes."
