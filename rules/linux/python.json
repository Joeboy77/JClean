  {
    "id": "linux.python.project-environments",
    "version": 1,
    "platforms": ["linux"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Project build folders",
    "labels": {
      "developer": "Virtual environments (.venv, venv)",
      "everyday": "Python environments in old projects"
    },
    "description": {
      "what": "Python packages installed for one project. Recreated from its requirements.",
      "ifCleared": "Recreate the environment and install the requirements before working on the project again."
    },
    "icon": "folder-tree",
    "risk": "safe",
    "regenerates": true,
    "detect": {
