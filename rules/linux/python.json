    "unused": {
      "basis": "project-activity",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete"
    }
  },
  {
    "id": "linux.python.project-caches",
    "version": 1,
    "platforms": ["linux"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Project build folders",
    "labels": {
      "developer": "Python caches (__pycache__, .pytest_cache…)",
      "everyday": "Python caches in old projects"
    },
    "description": {
      "what": "Compiled files and test caches Python tools write inside a project.",
      "ifCleared": "Python recreates them the next time the code runs."
    },
    "icon": "folder-cog",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "project-artifact",
      "markers": ["pyproject.toml", "requirements.txt", "setup.py"],
      "folders": ["__pycache__", ".pytest_cache", ".mypy_cache", ".tox"]
    },
    "unused": {
      "basis": "project-activity",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete"
    }
  }
