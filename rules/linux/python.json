  {
    "id": "linux.python.huggingface-models",
    "version": 1,
    "platforms": ["linux"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Machine learning models",
    "labels": {
      "developer": "Hugging Face hub cache",
      "everyday": "Downloaded AI models (Hugging Face)"
    },
    "description": {
      "what": "Models and datasets downloaded by Hugging Face libraries. Often several gigabytes each.",
      "ifCleared": "Code that uses these models downloads them again, which can take a long time."
