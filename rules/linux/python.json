    "icon": "brain",
    "risk": "review",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": ["{caches}/huggingface/hub"],
      "eachChild": true,
      "exclude": [".*", "version.txt"]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete"
    }
  },
  {
