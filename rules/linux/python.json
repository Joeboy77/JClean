    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "command",
      "command": {
        "tool": "conda",
        "args": ["clean", "--all", "-y"]
      }
    },
    "mayShareBlocks": true
