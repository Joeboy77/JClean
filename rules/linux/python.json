  {
    "id": "linux.python.conda-packages",
    "version": 1,
    "platforms": ["linux"],
    "audience": ["developer"],
    "category": "developer",
    "group": "Package caches",
    "labels": {
      "developer": "Conda package cache (pkgs)",
      "everyday": "Downloaded packages (Conda)"
    },
    "description": {
      "what": "Package archives and extracted packages Conda keeps after installing them into environments.",
      "ifCleared": "Conda removes packages no environment needs. Your environments keep working."
    },
    "icon": "package",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
