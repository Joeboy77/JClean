[
  {
    "id": "linux.browsers.chrome",
    "version": 1,
    "platforms": ["linux"],
    "audience": ["everyday", "developer"],
    "category": "apps",
    "group": "Browser caches",
    "labels": {
      "developer": "Chrome cache",
      "everyday": "Chrome's saved web data"
    },
    "description": {
      "what": "Copies of web pages, scripts and images Chrome keeps to load sites faster.",
      "ifCleared": "The browser downloads pages and images again as you visit sites. You stay signed in, and your history, bookmarks and passwords aren't touched."
    },
    "icon": "globe",
    "risk": "safe",
    "regenerates": true,
    "detect": {
      "kind": "fixed",
      "paths": [
        "{caches}/google-chrome",
        "{config}/google-chrome/*/Code Cache",
        "{config}/google-chrome/*/GPUCache",
        "{config}/google-chrome/*/Service Worker/CacheStorage"
      ]
    },
    "unused": {
      "basis": "newest-mtime",
      "minAgeDays": 0
    },
    "cleanup": {
      "method": "delete",
      "keepRoot": true
    },
    "relatedApps": ["chrome"]
  },
